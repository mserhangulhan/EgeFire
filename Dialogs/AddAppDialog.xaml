<Window x:Class="EasyTaskStarter.Dialogs.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kısayol Ekle" Height="350" Width="450"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        x:Name="Root">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Uygulama adı:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox x:Name="AppNameTextBox" Grid.Row="1" FontSize="14" Height="28" Margin="0,0,0,5"/>

        <TextBlock x:Name="PathLabel" Grid.Row="2" Text="Uygulama yolu:" FontSize="14" Margin="0,5,0,5"/>
        <Grid Grid.Row="3" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ExePathTextBox" Grid.Column="0" FontSize="14" Height="28" Margin="0,0,5,0" IsReadOnly="True"/>
            <Button x:Name="BtnBrowse" Grid.Column="1" Content="Gözat" Width="55" Height="28" Margin="0,0,4,0" Click="BtnBrowse_Click"/>
            <Button x:Name="BtnUrlMode" Grid.Column="2" Content="🌐 URL" Width="55" Height="28" Margin="0,0,4,0" Click="BtnUrlMode_Click" ToolTip="Web adresi (URL) ekle"/>
            <Button x:Name="BtnWhatsApp" Grid.Column="3" Content="💬 WA" Width="55" Height="28" Click="BtnWhatsApp_Click" ToolTip="WhatsApp Store Uygulaması Ekle"/>
        </Grid>

        <TextBlock Grid.Row="4" Text="Çalıştırma Argümanları (boşlukla ayırın):" FontSize="14" Margin="0,5,0,5"/>
        <TextBox x:Name="ArgumentsTextBox" Grid.Row="5" FontSize="14" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" ToolTip="Uygulamaya gönderilecek komut satırı argümanları (örn: --incognito)"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="İptal" Width="80" Height="30" Margin="0,0,5,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnAddOrSave" Content="Ekle" Width="80" Height="30" Click="BtnAdd_Click"/>
        </StackPanel>
    </Grid>
</Window>