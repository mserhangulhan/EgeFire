<Window x:Class="EasyTaskStarter.Dialogs.NotesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notlar (Scratchpad)" Height="500" Width="450"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📝 Notlar — Otomatik Kaydedilir" FontSize="14" FontWeight="Bold" 
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>

        <TextBox Grid.Row="1" Name="NotesTextBox"
                 AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Cascadia Code, monospace"
                 FontSize="12"
                 Background="{DynamicResource SearchBoxBackgroundBrush}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource SearchBoxBorderBrush}"
                 BorderThickness="1"
                 Padding="8"
                 TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Kaydet ve Kapat" Width="120" Height="30" Margin="4,0,0,0"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                    Click="BtnSave_Click"/>
            <Button Content="İptal" Width="80" Height="30" Margin="4,0,0,0"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource ButtonForegroundBrush}"
                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>