<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#333333"/>
    
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#2D2D30"/>

    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#888888"/>

    <SolidColorBrush x:Key="SearchBoxBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SearchBoxBorderBrush" Color="#444444"/>

    <SolidColorBrush x:Key="GroupBoxHeaderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="GroupBoxBorderBrush" Color="#444444"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#555555"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#4A4A4E"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#2D2D30"/>

    <SolidColorBrush x:Key="ListBoxBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ListBoxItemHoverBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="ListBoxItemSelectedBrush" Color="#094771"/>

    <SolidColorBrush x:Key="ContextMenuBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#444444"/>
    <SolidColorBrush x:Key="ContextMenuItemHoverBrush" Color="#3E3E42"/>

    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#444444"/>

</ResourceDictionary>